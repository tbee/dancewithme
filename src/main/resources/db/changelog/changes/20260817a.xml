<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        >

    <changeSet id="20260817a" author="tom">
        <!-- what a dancer is searching for in a partner (dancestyle + role) -->
        <createTable tableName="dancer_searching_for">
            <column name="id" type="bigint" autoIncrement="true" startWith="1">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lazylock" type="bigint" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="dancer_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dancestyle_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="dancer_searching_for" columnNames="dancer_id, dancestyle_id" constraintName="dancer_searching_for__dancer_dancestyle_UK"/>
        <addForeignKeyConstraint baseTableName="dancer_searching_for" baseColumnNames="dancer_id"
                                 referencedTableName="dancer" referencedColumnNames="id"
                                 constraintName="dancer_searching_for__dancer_FK"/>
        <addForeignKeyConstraint baseTableName="dancer_searching_for" baseColumnNames="dancestyle_id"
                                 referencedTableName="dancestyle" referencedColumnNames="id"
                                 constraintName="dancer_searching_for__dancestyle_FK"/>
        <addForeignKeyConstraint baseTableName="dancer_searching_for" baseColumnNames="role_id"
                                 referencedTableName="role" referencedColumnNames="id"
                                 constraintName="dancer_searching_for__role_FK"/>
    </changeSet>
</databaseChangeLog>
