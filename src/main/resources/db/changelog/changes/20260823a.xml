<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        >

    <changeSet id="20260823a" author="tom">
        <!-- email confirmation -->
        <addColumn tableName="dancer">
            <column name="email_confirmed_at" type="timestamp"/>
        </addColumn>
        <addColumn tableName="dancer">
            <column name="email_confirmation_token" type="varchar(255)"/>
        </addColumn>
        <addColumn tableName="dancer">
            <column name="email_confirmation_token_expires_at" type="timestamp"/>
        </addColumn>
        <addUniqueConstraint tableName="dancer" columnNames="email_confirmation_token" constraintName="dancer__email_confirmation_token_UK"/>
    </changeSet>
</databaseChangeLog>
